// ---------- Helpers ----------
function remove_bom($s) {
    return preg_replace('/^\xEF\xBB\xBF/','',$s);
}
function excelSerialToDate($serial) {
    if (!is_numeric($serial)) return null;
    $unix = ($serial - 25569) * 86400;
    return gmdate('Y-m-d', intval($unix));
}
function excelSerialToTime($serial) {
    if (!is_numeric($serial)) return null;
    $seconds = intval(($serial - floor($serial)) * 86400 + 0.5);
    return gmdate('H:i:s', $seconds);
}
function try_parse_date($s) {
    $s = trim($s); 
    if ($s === '') return null;
    if (is_numeric($s) && floatval($s) > 59) return excelSerialToDate(floatval($s));
    $formats = ['d/m/Y','j/n/Y','d-m-Y','Y-m-d','d/m/y','m/d/Y','d M Y','Y-m-d H:i:s'];
    foreach ($formats as $fmt) {
        $dt = DateTime::createFromFormat($fmt, $s);
        if ($dt !== false && !DateTime::getLastErrors()['warning_count'] && !DateTime::getLastErrors()['error_count'])
            return $dt->format('Y-m-d');
    }
    $t = strtotime($s);
    return ($t !== false && $t > 0) ? date('Y-m-d', $t) : null;
}
function try_parse_time($s) {
    $s = trim($s);
    if ($s === '' || strtoupper($s) === 'N/A') return null;
    if (is_numeric($s) && floatval($s) > 0 && floatval($s) < 2) return excelSerialToTime(floatval($s));
    $formats = ['H:i:s','H:i','g:i a','g:i A','h:i A','h:i a'];
    foreach ($formats as $fmt) {
        $dt = DateTime::createFromFormat($fmt, $s);
        if ($dt !== false && !DateTime::getLastErrors()['warning_count'] && !DateTime::getLastErrors()['error_count'])
            return $dt->format('H:i:s');
    }
    $t = strtotime($s);
    return ($t !== false) ? date('H:i:s', $t) : null;
}

// ---------- File Upload ----------
$inserted = $skipped = 0;

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_FILES['csvFile'])) {
    $fileTmp = $_FILES['csvFile']['tmp_name'];

    if (!file_exists($fileTmp)) die("File upload failed.");

    $handle = fopen($fileTmp, "r");
    if ($handle === false) die("Unable to open uploaded CSV file.");

    $rowNum = 0;
    $dateCol = $inCol = $outCol = $statusCol = null;
    $emp_id = $emp_name = "";
    $dataStarted = false;

    while (($row = fgetcsv($handle, 0, ",")) !== false) {
        $rowNum++;
        foreach ($row as $i => $c) $row[$i] = trim(remove_bom($c));
        $lineText = implode(" ", $row);

        // Detect new employee block
        if (preg_match('/\b(\d{3,})\s*\(\s*([^)]+)\s*\)/', $lineText, $m)) {
            $emp_id = trim($m[1]);
            $emp_name = trim($m[2]);
            $dataStarted = false;
            $dateCol = $inCol = $outCol = $statusCol = null;
            continue;
        }

        // Detect start of attendance table
        if (!$dataStarted) {
            foreach ($row as $i => $cell) {
                if (preg_match('/^\s*Date\s*$/i', $cell)) {
                    $dateCol = $i;
                    $dataStarted = true;
                    foreach ($row as $j => $h) {
                        $hLow = strtolower($h);
                        if (strpos($hLow, 'in') !== false && $inCol === null) $inCol = $j;
                        if (strpos($hLow, 'out') !== false && $outCol === null) $outCol = $j;
                        if ((strpos($hLow, 'status') !== false || strpos($hLow, 'remark') !== false) && $statusCol === null) $statusCol = $j;
                    }
                    continue 2;
                }
            }
            continue;
        }

        // Parse attendance rows
        $dateParsed = try_parse_date($row[$dateCol] ?? '');
        $inParsed   = isset($row[$inCol]) ? try_parse_time($row[$inCol]) : null;
        $outParsed  = isset($row[$outCol]) ? try_parse_time($row[$outCol]) : null;
        $status     = isset($row[$statusCol]) ? trim($row[$statusCol]) : '';

        if (strtoupper($status) === 'A') {
            $inParsed = "00:00:00";
            $outParsed = "00:00:00";
        }

        $statusValue = ($status !== '' ? $status : 'N/A');

        if ($dateParsed === null && $inParsed === null && $outParsed === null && $status === '') {
            $skipped++; 
            continue;
        }

        // Insert or update if duplicate (emp_id + date must be unique)
        $sql = "INSERT INTO employee_attendance (emp_id, emp_name, date, in_time, out_time, status)
            VALUES (
                '".$conn->real_escape_string($emp_id)."',
                '".$conn->real_escape_string($emp_name)."',
                ".($dateParsed ? "'".$conn->real_escape_string($dateParsed)."'" : "NULL").",
                '".$conn->real_escape_string($inParsed)."',
                '".$conn->real_escape_string($outParsed)."',
                '".$conn->real_escape_string($statusValue)."'
            )
            ON DUPLICATE KEY UPDATE
                emp_name = VALUES(emp_name),
                in_time = VALUES(in_time),
                out_time = VALUES(out_time),
                status = VALUES(status)";

        if ($conn->query($sql) === TRUE) {
            $inserted++;
        } else {
            $skipped++;
        }
    }

    fclose($handle);

    // Redirect to show alert without resubmitting the form
    header("Location: ".$_SERVER['PHP_SELF']."?inserted={$inserted}&skipped={$skipped}");
    exit;
}
$conn->close();
