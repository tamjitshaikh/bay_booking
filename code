<table>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <!-- Add more columns as per your table -->
    </tr>
    <?php
    if ($result->num_rows > 0) {
        while($row = $result->fetch_assoc()) {
            echo "<tr>
                    <td>".$row['id']."</td>
                    <td>".$row['name']."</td>
                    <td>".$row['email']."</td>
                  </tr>";
        }
    } else {
        echo "<tr><td colspan='3'>No records found.</td></tr>";
    }
    ?>
</table>

<div class="pagination">
    <?php
    // Previous Button
    echo "<button " . ($page <= 1 ? "disabled" : "") . " onclick=\"window.location='?page=" . ($page - 1) . "'\">Previous</button>";

    // Page Numbers
    for ($i = 1; $i <= $total_pages; $i++) {
        if ($i == $page) {
            echo "<strong>$i</strong> ";
        } else {
            echo "<a href='?page=$i'>$i</a> ";
        }
    }

    // Next Button
    echo "<button " . ($page >= $total_pages ? "disabled" : "") . " onclick=\"window.location='?page=" . ($page + 1) . "'\">Next</button>";
    ?>
</div>

</body>
</html>

<?php
$conn->close();
?>
